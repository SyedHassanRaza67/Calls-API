# ── Core ────────────────────────────────────────────────────────────────
# Postgres connection string (self-hosted Postgres container)
DATABASE_URL=postgres://calls:calls@db:5432/calls

# Secret used to sign JWTs (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# HTTP port the backend listens on
PORT=8080

# development | production
NODE_ENV=production

# Comma-separated list of allowed CORS origins. Use * to allow all (dev only).
CORS_ORIGIN=*

# ── Integration secrets (lead provider fallbacks) ───────────────────────
# Retreaver RTB fallback credentials (used by /api/leads/submit when a
# campaign config does not carry its own key/publisher_id).
RETREAVER_PUBLISHER_ID=
RETREAVER_RTB_KEY=

# Ringba (RTB / call routing). Currently RTB ID is read from the campaign's
# publisher_id or ping_url; these are placeholders for future server secrets.
RINGBA_API_TOKEN=
RINGBA_ACCOUNT_ID=

# LeadsPedia (a.k.a. Leadspedia). Campaign key/id come from the api_configuration
# row today; placeholders kept for parity / future server-side defaults.
LEADSPEDIA_API_KEY=
LEADSPEDIA_API_SECRET=

# TrackDrive. Used by /api/parse-trackdrive-url and the ping/post flows; the
# vanity URI + traffic_source_id come from the campaign config, these are spares.
TRACKDRIVE_PUBLIC_KEY=
TRACKDRIVE_PRIVATE_KEY=
