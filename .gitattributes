# Normalize line endings. Files that execute on the Linux VPS MUST stay LF,
# even though development happens on Windows.
* text=auto

*.sh        text eol=lf
*.mjs       text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
nginx.conf  text eol=lf
Dockerfile  text eol=lf
Dockerfile.* text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf

# Binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.lockb binary
