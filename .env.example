# ============================================================================
# Frontend (Vite) environment
# Copy to .env and adjust. Only VITE_* vars are exposed to the browser.
# ============================================================================

# Base URL of the calls-api backend. In Docker/prod this is the public API URL
# (e.g. https://api.yourdomain.com). In local dev it is the backend dev server.
VITE_API_URL="http://localhost:8080"
