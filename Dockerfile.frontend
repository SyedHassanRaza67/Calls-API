# Dockerfile.frontend — multi-stage: build the Vite/React SPA, serve with nginx.

# ---- Stage 1: build ----
FROM node:20-alpine AS build
WORKDIR /app

# VITE_API_URL is baked into the bundle at build time. "/api" (the default) makes the
# SPA call the same origin, where the bundled nginx reverse-proxies /api -> backend.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

# Install deps first for better layer caching. Use the lockfile when present.
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy the rest of the frontend source and build.
COPY . .
RUN npm run build

# ---- Stage 2: serve ----
FROM nginx:alpine AS serve

# SPA-aware nginx config (history fallback + /api proxy).
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Static build output.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
